DJANGO_SECRET_KEY=cambia-esta-clave-en-produccion
DJANGO_DEBUG=True
# Para desarrollo local. En producción con subdominios, agrega el
# patrón con punto al inicio para aceptar cualquier subdominio, ej:
# DJANGO_ALLOWED_HOSTS=observapaz.org,.observapaz.org
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Puerto en el que responde la aplicación dentro del servidor/PC anfitrión.
WEB_PORT=8010
# Puerto externo de PostgreSQL hacia tu PC/servidor (solo para conectarte
# con un cliente como pgAdmin; Django siempre usa el puerto 5432 interno).
DB_HOST_PORT=5433

DB_NAME=observapaz
DB_USER=observapaz
DB_PASSWORD=observapaz
DB_HOST=db
DB_PORT=5432

# --- Correo: alertas al gestor cuando llega un registro pendiente ---
# Deja EMAIL_BACKEND sin definir (o coméntalo) mientras pruebas: los
# correos se imprimen en los logs en vez de enviarse de verdad.
# Para envíos reales, descomenta y completa con tu proveedor SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.tu-proveedor.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=tu-usuario-smtp
# EMAIL_HOST_PASSWORD=tu-contraseña-smtp
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=OBSERVAPAZ <no-responder@tu-dominio.org>

# URL pública del sitio, para el enlace dentro del correo de alerta.
SITIO_URL_BASE=http://localhost:8010

# --- Subdominios por observatorio ---
# Dominio raíz (sin protocolo ni subdominio). Con esto, un subdominio
# como "obs-007.observapaz.org" se reconoce como el observatorio
# OBS-007. En desarrollo local, deja "localhost" (ver el manual para
# el truco del archivo hosts que permite probar subdominios en tu PC).
DOMINIO_BASE=localhost

# Opcional: si defines esto (ej. ".observapaz.org", con el punto al
# inicio), la sesión queda compartida entre todos los subdominios.
# Vacío = cada subdominio maneja su sesión por separado.
COOKIE_DOMINIO_COMPARTIDO=

# --- ODK Central (servidor aparte, ver el manual de instalación) ---
# Deja esto vacío mientras no tengas Central desplegado; el comando de
# sincronización simplemente no hace nada si falta cualquiera de estos.
ODK_CENTRAL_URL=https://odk.observapaz.org
ODK_CENTRAL_EMAIL=sincronizacion@observapaz.org
ODK_CENTRAL_PASSWORD=
ODK_CENTRAL_PROJECT_ID=
