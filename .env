# --- Correo: alertas al gestor cuando llega un registro pendiente ---
# Deja EMAIL_BACKEND sin definir (o coméntalo) mientras pruebas: los
# correos se imprimen en los logs en vez de enviarse de verdad.
# Para envíos reales, descomenta y completa con tu proveedor SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.tu-proveedor.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=tu-usuario-smtp
# EMAIL_HOST_PASSWORD=tu-contraseña-smtp
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=OBSERVAPAZ <no-responder@tu-dominio.org>

# URL pública del sitio, para el enlace dentro del correo de alerta.
SITIO_URL_BASE=http://localhost:8010